    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit verwendet die Kamera, um den QR-Code deines Recovery Kits zu scannen, und für Websites, denen du den Zugriff erlaubst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Orbit uses the camera to scan your Recovery Kit QR code, and for websites you allow to use it."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit öffnet Seiten in deinem lokalen Netzwerk, wenn du sie aufrufst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Orbit opens pages on your local network when you visit them."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, denen du es erlaubst, können deinen Standort verwenden, zum Beispiel für Karten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you allow can use your location, for example for maps."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Websites, denen du es erlaubst, können das Mikrofon verwenden, zum Beispiel für Anrufe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Websites you allow can use the microphone, for example for calls."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbit sichert Bilder von Websites in deiner Fotomediathek, wenn du sie sichern möchtest."
